# Application
# Left unset on purpose — see the comment in .env.development. Every service
# reads this file and would otherwise all bind the gateway's port.
NODE_ENV=production

# Keycloak Configuration
KEYCLOAK_AUTH_SERVER_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM=hmeet
KEYCLOAK_CLIENT_ID=hmeet-backend
KEYCLOAK_CLIENT_SECRET=your-production-client-secret

# JWT Configuration
JWT_ISSUER=https://keycloak.yourdomain.com/realms/hmeet
JWT_AUDIENCE=hmeet-backend

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com