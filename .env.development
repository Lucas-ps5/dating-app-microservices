# Application
# PORT is intentionally unset here. This file is loaded by every service (each
# app resolves its env file relative to the repo root, so all of them read this
# one), and a single value here would make users/chat/media/matches all try to
# bind the gateway's port. Each service falls back to its own default in
# apps/<service>/src/config/configuration.ts: 3000, 3001, 3002, 3003, 3004.
# Override a specific port from the shell, not from this file.
NODE_ENV=development

# Keycloak Configuration
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=hmeet
KEYCLOAK_CLIENT_ID=hmeet-backend
KEYCLOAK_CLIENT_SECRET=2Kux6kxJOGWbGNN9sm7NqHoOObK9MY8m

# JWT Configuration
JWT_ISSUER=http://localhost:8080/realms/hmeet
JWT_AUDIENCE=hmeet-backend

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:4200

# Downstream Services
USERS_SERVICE_URL=http://localhost:3001/api
CHAT_SERVICE_URL=http://localhost:3002/api
MEDIA_SERVICE_URL=http://localhost:3003/api